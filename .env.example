# MechSage — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── API Security ──────────────────────────────────────────────────────────────
API_KEY=dev-secret-key
REQUIRE_API_KEY=false

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Options: openai | gemini | ollama
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Google Gemini (alternative)
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_MODEL=gemini-1.5-flash

# Ollama (local, no internet required)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── Database ──────────────────────────────────────────────────────────────────
# Dev: SQLite (no setup needed)
DATABASE_URL=sqlite:///./mechsage.db
# Prod: PostgreSQL
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/mechsage

# ── Simulation ────────────────────────────────────────────────────────────────
SIMULATION_MAX_CYCLES=300
SIMULATION_SLEEP_SECONDS=0.5
SIMULATION_AUTO_START=true
SIMULATION_SEED=42

# ── RAG ───────────────────────────────────────────────────────────────────────
RAG_RELEVANCE_THRESHOLD=0.30
RAG_TOP_K=5

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=false   # set true in production for structured JSON logs

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
# These are consumed by Next.js — prefix with NEXT_PUBLIC_ for browser access
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/fleet
NEXT_PUBLIC_API_KEY=dev-secret-key
